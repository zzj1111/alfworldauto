# Site settings for the B200 sandbox. NO CREDENTIALS in this file (it is committed):
#   cp .autoscaffold.env.b200 .autoscaffold.env
#   $EDITOR .autoscaffold.env      # paste the two keys at the bottom
#   bash autoscaffold/start.sh --check

# ---- paths (adjust to the actual sandbox mounts) ----
ARM_WORKSPACE=/scratch/hongpaul-sandbox/alfscaffold/runs
ARM_CKPT_ROOT=/scratch/hongpaul-sandbox/alfscaffold/ckpts
# MUST be node-local disk (df -hT to confirm; NFS here took a node to load 400+)
ALFWORLD_DATA=/scratch/hongpaul-sandbox/data/alfworld_data
#ARM_MODEL=/scratch/hongpaul-sandbox/Qwen2.5-1.5B-Instruct   # or the hub id (default)

# ---- placement ----
ARM_GPUS=0,1,2,3,4,5,6,7
ARM_N_GPUS=8
ARM_TP=2
ARM_GPU_MEM=0.6
# vLLM attention backend: FLASH_ATTN is the proven default on H100/H200. On B200 set
# `auto` to let vllm choose, if flash-attn lacks sm_100 kernels.
ARM_VLLM_ATTN=auto

# ---- experiment ----
TRAIN_DATA_SIZE=32
ARM_ROLLOUT_N=8
ARM_K=10
ARM_VAL_N=3
ARM_KL=0.01
ARM_CYCLES=30
ARM_TARGET_STEP=300
ARM_AB_EPISODES=180
ARM_KEEPALIVE=plain-rl

# ---- wandb ----
ARM_WANDB=1
ARM_WANDB_ENTITY=mhong-university-of-minnesota
ARM_WANDB_PROJECT=verl_agent_alfworld

# ---- paste into .autoscaffold.env only (never here, never on a command line) ----
#OPENAI_API_KEY=
#WANDB_API_KEY=
