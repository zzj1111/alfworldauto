# Site settings. Copy to .autoscaffold.env (gitignored), edit, then
#   bash autoscaffold/start.sh --check
# Caller environment overrides this file; this file overrides the defaults.
# Values may carry trailing comments after ` #`.

# ---- paths (defaults live under the repo; point at fast local disk on a cluster) ----
#ARM_WORKSPACE=/scratch/you/autoscaffold/runs
#ARM_EXP_ROOT=/scratch/you/autoscaffold/exp
#ARM_CKPT_ROOT=/scratch/you/autoscaffold/ckpts
#ARM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# MUST be node-local disk, not NFS: the env scans ~18k small files at startup.
#ALFWORLD_DATA=/scratch/you/alfworld_data

# ---- placement ----
ARM_GPUS=0,1
ARM_N_GPUS=2
ARM_TP=2
ARM_GPU_MEM=0.6

# ---- experiment ----
ARM_EXP=alf_autoscaffold
TRAIN_DATA_SIZE=32        # prompts per step; x ARM_ROLLOUT_N = episodes per step
ARM_ROLLOUT_N=8           # GRPO group size (the trainer and the signals read THIS)
ARM_K=10                  # training steps per scaffold cycle
ARM_VAL_N=3               # independent eval draws per cycle
ARM_KL=0.01               # 0 disables the KL loss
ARM_CYCLES=30             # cycles one process runs
ARM_TARGET_STEP=300       # absolute finish line; survives restarts
ARM_AB_EPISODES=180       # A/B budget per condition, split across touched categories
#ARM_BARE_LOSS=False     # True re-enables the bare-prompt loss swap (ablation)
ARM_KEEPALIVE=none        # plain-rl | none

# ---- wandb ----
ARM_WANDB=0
#ARM_WANDB_ENTITY=
#ARM_WANDB_PROJECT=verl_agent_alfworld

# ---- credentials (or export them; never on a command line) ----
#OPENAI_API_KEY=
#WANDB_API_KEY=
